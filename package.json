{
  "name": "creatign-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Creatign Ledger: accounting and billing for Creatign (INR, April-March fiscal year)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "reset-data": "tsx server/reset.ts",
    "db:import": "tsx server/import-json.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.3",
    "aws-ssl-profiles": "^1.1.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.78.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}

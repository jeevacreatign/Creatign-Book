# Copy this file to .env (same folder) and fill in your details.
# .env is ignored by git, so your password never goes to GitHub.

# --- Database (required) ---
# MongoDB 8+. For local development, docker-compose.yml starts MongoDB at this address.
MONGODB_URI=mongodb://127.0.0.1:27017/creatign_ledger
# Optional database name override when the URI does not include one.
# MONGODB_DATABASE=creatign_ledger
# One-time migration from the old local MySQL database. Never set this on the running app.
# SOURCE_MYSQL_URL=mysql://ledger:ledger-dev-password@localhost:3306/creatign_ledger

# --- Email sending (Gmail) ---
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-letter app password below (spaces are fine). Do NOT use your normal Gmail password.
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Name shown as the sender. Defaults to the organisation name.
MAIL_FROM_NAME=Creatign

# Only change these for a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# If your network's SMTP connection uses a private CA, set this to its PEM certificate file.
# Do not disable certificate validation.
# SMTP_TLS_CA_FILE=C:\path\to\trusted-mail-ca.pem

# --- Optional Gmail account linking (OAuth) ---
# Enable the Gmail API in Google Cloud and create a Web application OAuth client.
# Add http://localhost:4000/api/mail/google/callback as an authorized redirect URI.
# The client secret is also used to encrypt the locally stored refresh token.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/mail/google/callback
# APP_ORIGIN=http://localhost:5173

# --- Email: other options ---
# SMTP can also be set up in the app (Settings > Emails); those settings win over the lines above.
# MAIL_FROM_EMAIL=billing@yourcompany.in
# Keep every email in the outbox (Settings > Emails > Email Log) instead of sending it. Handy in development.
# MAIL_TRANSPORT=outbox

# --- Customer portal and links in emails ---
# Public address of the app, used for "View Invoice" buttons, portal invitations and password resets.
# Can also be set in Settings > Customer Portal > Portal URL.
# APP_ORIGIN=https://books.yourcompany.in
# Key used to encrypt passwords saved in Settings (e.g. the SMTP password).
# If unset, a random key is created in server/data/app-secret.json; keep that file with your backups.
# APP_SECRET=a-long-random-string

# --- Server ---
# PORT=4000
# On a public server: only this address may create the first Admin account.
# ADMIN_EMAIL=you@yourcompany.in
# Behind proxies (2 = CloudFront + load balancer), so sign-in limits see the visitor's IP.
# TRUST_PROXY=2
# Sign-in is required for the staff app. AUTH_DISABLED=1 turns it off (tests only; never on a shared server).
# AUTH_DISABLED=

# Live exchange rates (Settings > Currencies > Refresh Rates). Fetched on the server only.
# Default (auto): ECB reference rates, then central-bank pegs, then ExchangeRate-API open access; no API key.
# FX_RATES_PROVIDER=frankfurter      # ECB and pegs only; or exchangerate-api; or openexchangerates
# FX_FALLBACK_URL=                   # ExchangeRate-API mirror, e.g. https://open.er-api.com/v6
# Local: copy this file to .env (git ignores .env) and put the real key there. On AWS use
# ./deploy/aws/set-rate-keys.sh instead (Secrets Manager).
# OPENEXCHANGERATES_APP_ID=          # free App ID from https://openexchangerates.org: live mid-market rates,
#                                    # refreshed hourly (Settings > Currencies > Rate type). Keep it out of git.
# FX_MIDMARKET_STALE_HOURS=24        # mid-market rate is stale after this many market hours
# FX_RATES_URL=                      # e.g. a self-hosted Frankfurter: https://rates.example.com/v1
# FRED_API_KEY=                     # free key from https://fred.stlouisfed.org: USD from the Federal Reserve
# FX_RATES_STALE_DAYS=4
# FX_AUTO_REFRESH=0                  # turn off the automatic refresh (hourly for mid-market, 6-hourly otherwise)

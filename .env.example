# Copy this file to .env (same folder) and fill in your details.
# .env is ignored by git, so your password never goes to GitHub.

# --- Email sending (Gmail) ---
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-letter app password below (spaces are fine). Do NOT use your normal Gmail password.
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Name shown as the sender. Defaults to the organisation name.
MAIL_FROM_NAME=Creatign

# Only change these for a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# If your network's SMTP connection uses a private CA, set this to its PEM certificate file.
# Do not disable certificate validation.
# SMTP_TLS_CA_FILE=C:\path\to\trusted-mail-ca.pem

# --- Optional Gmail account linking (OAuth) ---
# Enable the Gmail API in Google Cloud and create a Web application OAuth client.
# Add http://localhost:4000/api/mail/google/callback as an authorized redirect URI.
# The client secret is also used to encrypt the locally stored refresh token.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/mail/google/callback
# APP_ORIGIN=http://localhost:5173

# --- Server ---
# PORT=4000
